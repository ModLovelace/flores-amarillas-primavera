{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "functions": {
    "api/open.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/s/:id", "destination": "/api/open?id=:id" },
    { "source": "/r/:token", "destination": "/api/open?r=:token" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
